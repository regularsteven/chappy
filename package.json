{
  "name": "chappy",
  "version": "0.0.2",
  "description": "Chat-first browser built with Electron, Vue, and Tailwind.",
  "main": "main/main.js",
  "scripts": {
    "prepare:icons": "node scripts/prepare-icons.js",
    "dev": "npm run prepare:icons && concurrently --kill-others-on-fail \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "node scripts/free-port.js 5173 && vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:main": "wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RUN_AS_NODE= VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "npm run prepare:icons && vite build",
    "build:vue-update": "npm run build:renderer && node scripts/build-vue-update.js",
    "build:test-zip": "npm run build:renderer && node scripts/package-build.js",
    "build:desktop": "npm run build:renderer && node scripts/write-vue-build-json.js && node scripts/write-build-info.js && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never && node scripts/print-release-paths.js",
    "build:desktop:ci": "npm run build:renderer && node scripts/write-vue-build-json.js && node scripts/write-build-info.js && electron-builder --mac dmg zip --publish never && node scripts/print-release-paths.js",
    "build:windows": "npm run build:renderer && node scripts/write-vue-build-json.js && node scripts/write-build-info.js && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis portable --publish never && node scripts/print-release-paths.js",
    "build": "npm run build:vue-update",
    "build:full": "npm run build:desktop",
    "start": "npm run dev",
    "test": "node scripts/check-tabs.mjs",
    "test:services": "node scripts/check-service-loads.mjs",
    "test:fetch-icon": "node scripts/test-fetch-icon.mjs",
    "test:icon-full-flow": "node scripts/test-icon-full-flow.mjs",
    "release-notes": "node scripts/collate-release-notes.js",
    "postinstall": "npm run prepare:icons && node scripts/brand-electron.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "extract-zip": "^2.0.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-vue": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^26.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.regularsteven.chappy",
    "productName": "Chappy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main/**/*",
      "resources/**/*",
      "package.json",
      "build-info.json"
    ],
    "afterSign": "scripts/notarize.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/chappy-logo.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "Developer ID Application",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Chappy-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Chappy-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "resources/chappy-logo.png",
      "target": ["nsis", "portable"]
    }
  }
}
